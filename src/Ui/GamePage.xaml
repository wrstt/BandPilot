<UserControl x:Class="BandPilot.Ui.GamePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource F.Sans}">
  <Grid Margin="18,16,18,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <TextBlock Text="Game mode" Style="{StaticResource T.PageTitle}"/>
      <Border x:Name="StateChip" CornerRadius="99" Padding="9,3" HorizontalAlignment="Right"
              VerticalAlignment="Center" BorderThickness="1"
              BorderBrush="{DynamicResource B.TextFaint}">
        <TextBlock x:Name="StateChipText" Text="off" FontSize="10.5" FontWeight="SemiBold"
                   Foreground="{DynamicResource B.TextFaint}"/>
      </Border>
    </Grid>

    <!-- Said plainly, because the category is full of tools that promise
         otherwise and cannot deliver it. -->
    <Border Grid.Row="1" Margin="0,13,0,0" CornerRadius="8" Padding="12,10"
            Background="{DynamicResource B.Accent2Tint}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="3"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" CornerRadius="2" Background="{DynamicResource B.Accent2}"/>
        <TextBlock Grid.Column="1" Margin="11,0,0,0" FontSize="12" LineHeight="17"
                   TextWrapping="Wrap" Foreground="{DynamicResource B.TextSecondary}">
          <Run Text="This is interruption suppression, not an FPS booster." FontWeight="SemiBold"/>
          <Run Text=" It stops updaters and sync clients stealing CPU, memory bandwidth and uplink mid-match. Measured frame-rate gains from tools like this are low single digits and often zero — the benefit is fewer stutters, not a higher number. It never stops Windows services, and everything it does undoes itself if BandPilot closes."/>
        </TextBlock>
      </Grid>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,13,0,0" Padding="16,13">
      <StackPanel>
        <TextBlock Text="THE GAME" Style="{StaticResource T.Kicker}"
                   Foreground="{DynamicResource B.Accent}"/>
        <Grid Margin="0,9,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <ComboBox x:Name="GameBox" Style="{StaticResource Input.Combo}"
                    DisplayMemberPath="Label"/>
          <Button Grid.Column="1" Style="{StaticResource Btn.Secondary}" Content="Refresh"
                  Margin="9,0,0,0" Click="OnRefreshGames"/>
          <Button Grid.Column="2" x:Name="BtnToggle" Style="{StaticResource Btn.Primary}"
                  Content="Start game mode" Margin="9,0,0,0" MinWidth="150" Click="OnToggle"/>
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
          <CheckBox x:Name="OptNetwork" Style="{StaticResource Input.Check}" IsChecked="True"
                    Content="Lift Windows' network throttle"
                    ToolTip="Windows caps non-multimedia traffic near 10 000 packets a second"/>
          <CheckBox x:Name="OptPower" Style="{StaticResource Input.Check}" Margin="18,0,0,0"
                    IsChecked="True" Content="High-performance power plan"
                    ToolTip="Copies the built-in plan; your own plans are never edited"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0" ClipToBounds="True">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" BorderBrush="{DynamicResource B.Hairline}" BorderThickness="0,0,0,1"
                Padding="14,10">
          <TextBlock Text="WHAT WAS CHANGED" Style="{StaticResource T.Kicker}"/>
        </Border>

        <ListBox x:Name="LogList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                 HorizontalContentAlignment="Stretch" Focusable="False"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Focusable" Value="False"/>
              <Setter Property="Padding" Value="0"/>
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter/>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="14,7">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Ellipse Width="6" Height="6" VerticalAlignment="Top" Margin="0,6,10,0"
                         Fill="{Binding Dot}"/>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Description}" Style="{StaticResource T.Body}"
                             FontSize="12" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding Detail}" Visibility="{Binding DetailVisibility}"
                             Style="{StaticResource T.Dim}" FontSize="11" Margin="0,2,0,0"
                             TextWrapping="Wrap"/>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border x:Name="EmptyState" Grid.Row="1" Margin="16" CornerRadius="10"
                Background="{DynamicResource B.Surface}"
                BorderThickness="1" BorderBrush="{DynamicResource B.Hairline}">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Nothing changed yet" FontSize="13" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Foreground="{DynamicResource B.TextSecondary}"/>
            <TextBlock Margin="0,5,0,0" FontSize="12" HorizontalAlignment="Center"
                       TextAlignment="Center" MaxWidth="460" TextWrapping="Wrap"
                       Foreground="{DynamicResource B.TextFaint}"
                       Text="Pick a running game and start. Every change is listed here as it happens, and reversed when the game exits."/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <TextBlock x:Name="StatusLine" Grid.Row="4" Style="{StaticResource T.Dim}" FontSize="12"
               Margin="0,11,0,0" TextWrapping="Wrap"/>
  </Grid>
</UserControl>
