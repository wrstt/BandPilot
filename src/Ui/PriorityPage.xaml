<UserControl x:Class="BandPilot.Ui.PriorityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource F.Sans}">
  <Grid Margin="18,16,18,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Priority and limits" Style="{StaticResource T.PageTitle}"/>

    <Border x:Name="QosWarn" Grid.Row="1" Margin="0,13,0,0" CornerRadius="8" Padding="12,10"
            Background="{DynamicResource B.WarnTint}" Visibility="Collapsed">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="3"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" CornerRadius="2" Background="{DynamicResource B.WarnRail}"/>
        <TextBlock Grid.Column="1" Margin="11,0,10,0" FontSize="12" VerticalAlignment="Center"
                   TextWrapping="Wrap" Foreground="{DynamicResource B.TextSecondary}"
                   Text="Priority marking is currently inactive on this PC — Windows is ignoring these rules."/>
        <Button Grid.Column="2" Style="{StaticResource Btn.Ghost}" Content="Enable QoS marking"
                VerticalAlignment="Center" Click="OnEnableQos"/>
      </Grid>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,13,0,0" ClipToBounds="True">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{DynamicResource B.Hairline}" BorderThickness="0,0,0,1"
                Padding="14,10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="160"/>
              <ColumnDefinition Width="160"/>
              <ColumnDefinition Width="72"/>
              <ColumnDefinition Width="90"/>
              <ColumnDefinition Width="*" MinWidth="150"/>
              <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="RULE" Style="{StaticResource T.Kicker}"/>
            <TextBlock Grid.Column="1" Text="APPLICATION" Style="{StaticResource T.Kicker}"/>
            <TextBlock Grid.Column="2" Text="PROTOCOL" Style="{StaticResource T.Kicker}"/>
            <TextBlock Grid.Column="3" Text="PORT" Style="{StaticResource T.Kicker}"/>
            <TextBlock Grid.Column="4" Text="PRIORITY" Style="{StaticResource T.Kicker}"/>
            <TextBlock Grid.Column="5" Text="LIMIT" Style="{StaticResource T.Kicker}"
                       HorizontalAlignment="Right"/>
          </Grid>
        </Border>

        <ListBox x:Name="RuleList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="OnRuleSelected">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0"/>
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bd" Background="Transparent" BorderThickness="2,0,0,0"
                            BorderBrush="Transparent">
                      <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.RowHover}"/>
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.RowSelected}"/>
                        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource B.Accent2}"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Height="34" Margin="14,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="160"/>
                  <ColumnDefinition Width="160"/>
                  <ColumnDefinition Width="72"/>
                  <ColumnDefinition Width="90"/>
                  <ColumnDefinition Width="*" MinWidth="150"/>
                  <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource T.Body}"
                           FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding Application}" FontSize="11.5"
                           FontFamily="{StaticResource F.Mono}" VerticalAlignment="Center"
                           Foreground="{DynamicResource B.TextSecondary}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="{Binding Protocol}" Style="{StaticResource T.Secondary}" FontSize="12"/>
                <TextBlock Grid.Column="3" Text="{Binding RemotePort}" Style="{StaticResource T.Secondary}" FontSize="12"/>
                <TextBlock Grid.Column="4" Text="{Binding DscpLabel}" Style="{StaticResource T.Body}"
                           FontSize="12" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="5" Text="{Binding ThrottleLabel}" Style="{StaticResource T.Secondary}"
                           FontSize="12" HorizontalAlignment="Right"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- Most people arrive here with no rules and no idea what to make, so
             the empty state offers two concrete starting points. -->
        <Border x:Name="EmptyState" Grid.Row="1" Visibility="Collapsed" Margin="16"
                Background="{DynamicResource B.Surface}"
                CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource B.Hairline}">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Create your first rule" FontSize="13" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Foreground="{DynamicResource B.TextSecondary}"/>
            <TextBlock Text="Give one app priority over everything else, or hold one back."
                       Margin="0,5,0,0" FontSize="12" HorizontalAlignment="Center"
                       Foreground="{DynamicResource B.TextFaint}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
              <Button Style="{StaticResource Btn.Secondary}" Content="Prioritise a game" Click="OnStarterGame"/>
              <Button Style="{StaticResource Btn.Secondary}" Content="Throttle a backup app"
                      Margin="9,0,0,0" Click="OnStarterBackup"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,13">
      <StackPanel>
        <TextBlock Text="RULE EDITOR" Style="{StaticResource T.Kicker}"
                   Foreground="{DynamicResource B.Accent}"/>
        <Grid Margin="0,11,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="Rule name" Style="{StaticResource T.Secondary}" FontSize="12"/>
          <TextBox   Grid.Row="1" Grid.Column="0" x:Name="FName" Style="{StaticResource Input.Text}" Margin="0,4,0,0"/>

          <TextBlock Grid.Row="0" Grid.Column="2" Text="Application" Style="{StaticResource T.Secondary}" FontSize="12"/>
          <Grid Grid.Row="1" Grid.Column="2" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FApp" Style="{StaticResource Input.Text}"/>
            <Button Grid.Column="1" Style="{StaticResource Btn.Secondary}" Content="Browse…"
                    Margin="7,0,0,0" Click="OnBrowse"/>
          </Grid>

          <TextBlock Grid.Row="0" Grid.Column="4" Text="Protocol" Style="{StaticResource T.Secondary}" FontSize="12"/>
          <ComboBox  Grid.Row="1" Grid.Column="4" x:Name="FProto" Style="{StaticResource Input.Combo}" Margin="0,4,0,0"/>

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Remote port" Style="{StaticResource T.Secondary}"
                     FontSize="12" Margin="0,12,0,0"/>
          <TextBox   Grid.Row="3" Grid.Column="0" x:Name="FPort" Style="{StaticResource Input.Text}" Margin="0,4,0,0"/>

          <TextBlock Grid.Row="2" Grid.Column="2" Text="Priority" Style="{StaticResource T.Secondary}"
                     FontSize="12" Margin="0,12,0,0"/>
          <ComboBox  Grid.Row="3" Grid.Column="2" x:Name="FDscp" Style="{StaticResource Input.Combo}" Margin="0,4,0,0"/>

          <TextBlock Grid.Row="2" Grid.Column="4" Text="Limit (Mbit/s) — empty = unlimited"
                     Style="{StaticResource T.Secondary}" FontSize="12" Margin="0,12,0,0"/>
          <TextBox   Grid.Row="3" Grid.Column="4" x:Name="FLimit" Style="{StaticResource Input.Text}" Margin="0,4,0,0"/>
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
          <Button Style="{StaticResource Btn.Primary}" Content="Save rule" Click="OnSave"/>
          <Button Style="{StaticResource Btn.Danger}" Content="Delete rule" Margin="9,0,0,0" Click="OnDelete"/>
          <Button Style="{StaticResource Btn.Secondary}" Content="Reload" Margin="9,0,0,0" Click="OnReload"/>
          <TextBlock x:Name="StatusLine" Style="{StaticResource T.Dim}" FontSize="12"
                     Margin="13,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
