<!--
    Light "ocean" palette. Colour tokens only — no styles live here, so a theme
    is a single swappable dictionary and Theme.xaml never has to know which one
    is loaded. Both palettes must define exactly the same keys.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Color x:Key="C.Background">#EEF5F3</Color>
  <Color x:Key="C.Surface">#FFFFFF</Color>
  <Color x:Key="C.Text">#1C3A3E</Color>
  <Color x:Key="C.Heading">#14484F</Color>
  <Color x:Key="C.TextSecondary">#42605F</Color>
  <Color x:Key="C.TextDim">#5F7A7D</Color>
  <Color x:Key="C.TextFaint">#7A938F</Color>
  <Color x:Key="C.Accent">#0E7490</Color>
  <Color x:Key="C.Accent2">#0D9488</Color>
  <Color x:Key="C.Good">#15803D</Color>
  <Color x:Key="C.WarnText">#B45309</Color>
  <Color x:Key="C.WarnRail">#CA8A04</Color>
  <Color x:Key="C.Bad">#B91C1C</Color>
  <Color x:Key="C.Band6">#0F766E</Color>
  <Color x:Key="C.Band5">#0E7490</Color>
  <Color x:Key="C.Band24">#5B7280</Color>
  <Color x:Key="C.CloseHover">#D05D5D</Color>

  <!-- What hairlines and row washes tint with. On light ground that is the text
       colour; the dark palette needs a lighter one, so both define the token and
       the styles never have to know which theme is loaded. -->
  <Color x:Key="C.Line">#1C3A3E</Color>

  <SolidColorBrush x:Key="B.Background" Color="{StaticResource C.Background}"/>
  <SolidColorBrush x:Key="B.Surface" Color="{StaticResource C.Surface}"/>
  <SolidColorBrush x:Key="B.Text" Color="{StaticResource C.Text}"/>
  <SolidColorBrush x:Key="B.Heading" Color="{StaticResource C.Heading}"/>
  <SolidColorBrush x:Key="B.TextSecondary" Color="{StaticResource C.TextSecondary}"/>
  <SolidColorBrush x:Key="B.TextDim" Color="{StaticResource C.TextDim}"/>
  <SolidColorBrush x:Key="B.TextFaint" Color="{StaticResource C.TextFaint}"/>
  <SolidColorBrush x:Key="B.Accent" Color="{StaticResource C.Accent}"/>
  <SolidColorBrush x:Key="B.Accent2" Color="{StaticResource C.Accent2}"/>
  <SolidColorBrush x:Key="B.Good" Color="{StaticResource C.Good}"/>
  <SolidColorBrush x:Key="B.WarnText" Color="{StaticResource C.WarnText}"/>
  <SolidColorBrush x:Key="B.WarnRail" Color="{StaticResource C.WarnRail}"/>
  <SolidColorBrush x:Key="B.Bad" Color="{StaticResource C.Bad}"/>
  <SolidColorBrush x:Key="B.Band6" Color="{StaticResource C.Band6}"/>
  <SolidColorBrush x:Key="B.Band5" Color="{StaticResource C.Band5}"/>
  <SolidColorBrush x:Key="B.Band24" Color="{StaticResource C.Band24}"/>
  <SolidColorBrush x:Key="B.CloseHover" Color="{StaticResource C.CloseHover}"/>

  <SolidColorBrush x:Key="B.Band6Bg" Color="{StaticResource C.Band6}" Opacity="0.10"/>
  <SolidColorBrush x:Key="B.Band5Bg" Color="{StaticResource C.Band5}" Opacity="0.10"/>
  <SolidColorBrush x:Key="B.Band24Bg" Color="{StaticResource C.Band24}" Opacity="0.10"/>

  <SolidColorBrush x:Key="B.Hairline" Color="{StaticResource C.Line}" Opacity="0.10"/>
  <SolidColorBrush x:Key="B.RowRule" Color="{StaticResource C.Line}" Opacity="0.06"/>
  <SolidColorBrush x:Key="B.RowHover" Color="{StaticResource C.Accent2}" Opacity="0.05"/>
  <SolidColorBrush x:Key="B.RowSelected" Color="{StaticResource C.Accent2}" Opacity="0.08"/>
  <SolidColorBrush x:Key="B.RowConnected" Color="{StaticResource C.Accent}" Opacity="0.06"/>
  <SolidColorBrush x:Key="B.AccentTint" Color="{StaticResource C.Accent}" Opacity="0.10"/>
  <SolidColorBrush x:Key="B.Accent2Tint" Color="{StaticResource C.Accent2}" Opacity="0.10"/>
  <SolidColorBrush x:Key="B.WarnTint" Color="{StaticResource C.WarnRail}" Opacity="0.10"/>
  <SolidColorBrush x:Key="B.Overlay" Color="{StaticResource C.Text}" Opacity="0.35"/>

  <DropShadowEffect x:Key="E.Card" BlurRadius="6" ShadowDepth="1" Direction="270"
                    Color="{StaticResource C.Text}" Opacity="0.10"/>
</ResourceDictionary>
