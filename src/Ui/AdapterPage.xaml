<UserControl x:Class="BandPilot.Ui.AdapterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource F.Sans}">
  <Grid Margin="18,16,18,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <TextBlock Text="Adapter" Style="{StaticResource T.PageTitle}"/>
      <CheckBox x:Name="ShowAll" Style="{StaticResource Input.Check}" HorizontalAlignment="Right"
                VerticalAlignment="Center" Content="Show every driver setting" Click="OnToggleAll"/>
    </Grid>

    <TextBlock x:Name="SubHeader" Grid.Row="1" Style="{StaticResource T.Dim}" FontSize="12"
               Margin="0,6,0,0" TextWrapping="Wrap"/>

    <!-- Explains the link between this page and the Bands page, which is
         otherwise invisible: pinning is temporary, roaming is what holds it. -->
    <Border Grid.Row="2" Margin="0,13,0,0" CornerRadius="8" Padding="12,10"
            Background="{StaticResource B.Accent2Tint}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="3"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" CornerRadius="2" Background="{StaticResource B.Accent2}"/>
        <TextBlock Grid.Column="1" Margin="11,0,0,0" FontSize="12" LineHeight="17"
                   TextWrapping="Wrap" Foreground="{StaticResource B.TextSecondary}">
          <Run Text="A radio pinned on Bands &amp; APs lasts only for the current connection. "/>
          <Run Text="Roaming Aggressiveness" FontWeight="SemiBold" Foreground="{StaticResource B.Accent}"/>
          <Run Text=" is what stops Windows drifting back — set it to the lowest value to hold your choice."/>
        </TextBlock>
      </Grid>
    </Border>

    <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,13,0,0" ClipToBounds="True">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{StaticResource B.Hairline}" BorderThickness="0,0,0,1"
                Padding="14,10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="250"/>
              <ColumnDefinition Width="190"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="SETTING" Style="{StaticResource T.Kicker}"/>
            <TextBlock Grid.Column="1" Text="CURRENT VALUE" Style="{StaticResource T.Kicker}"/>
            <TextBlock Grid.Column="2" Text="DRIVER KEYWORD" Style="{StaticResource T.Kicker}"/>
          </Grid>
        </Border>

        <ListBox x:Name="SettingList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="OnSettingSelected">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0"/>
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bd" Background="Transparent" BorderThickness="2,0,0,0"
                            BorderBrush="Transparent">
                      <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="bd" Property="Background" Value="{StaticResource B.RowHover}"/>
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="bd" Property="Background" Value="{StaticResource B.RowSelected}"/>
                        <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.Accent2}"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Height="34" Margin="14,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="250"/>
                  <ColumnDefinition Width="190"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" Style="{StaticResource T.Body}"
                           FontSize="12" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding DisplayValue}" Style="{StaticResource T.Secondary}"
                           FontSize="12" TextTrimming="CharacterEllipsis"/>
                <TextBox Grid.Column="2" Text="{Binding RegistryKeyword, Mode=OneWay}" IsReadOnly="True"
                         BorderThickness="0" Background="Transparent" Padding="0"
                         FontFamily="{StaticResource F.Mono}" FontSize="11.5"
                         Foreground="{StaticResource B.TextFaint}" VerticalAlignment="Center"
                         Cursor="IBeam"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,13,0,0">
      <TextBlock x:Name="ChangeLabel" Style="{StaticResource T.Secondary}" FontSize="12.5"
                 VerticalAlignment="Center" Text="Select a setting to change it"/>
      <ComboBox x:Name="ValueBox" Style="{StaticResource Input.Combo}" Width="240" Margin="10,0,0,0"/>
      <Button x:Name="BtnApply" Style="{StaticResource Btn.Primary}" Content="Apply setting"
              Margin="10,0,0,0" IsEnabled="False" Click="OnApply"/>
      <Button x:Name="BtnReload" Style="{StaticResource Btn.Secondary}" Content="Reload"
              Margin="9,0,0,0" Click="OnReload"/>
    </StackPanel>

    <TextBlock x:Name="StatusLine" Grid.Row="5" Style="{StaticResource T.Dim}" FontSize="12"
               Margin="0,11,0,0" TextWrapping="Wrap"/>
  </Grid>
</UserControl>
