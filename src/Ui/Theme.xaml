<!--
    Design tokens for the light "ocean" theme, ported from the design handoff's
    tokens.json. Everything visual traces back to a value in here, so a palette
    change is a single-file edit.

    Note the collision the original theme had is resolved: bands are teal /
    ocean / slate and status is green / yellow / red, so a band colour can never
    be mistaken for a health colour.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Colour tokens live in Palette.Light.xaml / Palette.Dark.xaml, merged
       ahead of this dictionary. Everything below refers to them with
       DynamicResource so a palette swap repaints the running window instead of
       needing a restart. -->

  <!-- ========================== typography =========================== -->
  <!-- Inter is the design font; Segoe UI is the guaranteed Windows fallback. -->
  <FontFamily x:Key="F.Sans">Inter, Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="F.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>

  <!-- ============================ effects ============================ -->
  <DropShadowEffect x:Key="E.Card" BlurRadius="6" ShadowDepth="1" Direction="270"
                    Color="{StaticResource C.Text}" Opacity="0.10"/>

  <!-- ============================= text ============================== -->
  <Style x:Key="T.PageTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource F.Sans}"/>
    <Setter Property="FontSize" Value="19"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource B.Heading}"/>
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
  </Style>

  <Style x:Key="T.Body" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource F.Sans}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="T.Dim" TargetType="TextBlock" BasedOn="{StaticResource T.Body}">
    <Setter Property="Foreground" Value="{DynamicResource B.TextDim}"/>
  </Style>

  <Style x:Key="T.Secondary" TargetType="TextBlock" BasedOn="{StaticResource T.Body}">
    <Setter Property="Foreground" Value="{DynamicResource B.TextSecondary}"/>
  </Style>

  <!-- Small uppercase labels: table headers and the stat-row kickers. -->
  <Style x:Key="T.Kicker" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource F.Sans}"/>
    <Setter Property="FontSize" Value="9.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource B.TextFaint}"/>
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
  </Style>

  <Style x:Key="T.Mono" TargetType="TextBlock" BasedOn="{StaticResource T.Body}">
    <Setter Property="FontFamily" Value="{StaticResource F.Mono}"/>
    <Setter Property="FontSize" Value="11.5"/>
  </Style>

  <!-- =========================== surfaces ============================ -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource B.Surface}"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource B.Hairline}"/>
    <Setter Property="Effect" Value="{DynamicResource E.Card}"/>
  </Style>

  <!-- ============================ buttons ============================ -->
  <!-- Outlined rather than filled, per the design's Nocturne button language. -->
  <Style x:Key="Btn.Base" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource F.Sans}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Padding" Value="13,6"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Opacity" Value="0.78"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Opacity" Value="0.40"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Btn.Primary" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource B.Accent}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style x:Key="Btn.Secondary" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{DynamicResource B.Hairline}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
  </Style>

  <Style x:Key="Btn.Ghost" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource B.Accent}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style x:Key="Btn.Danger" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{DynamicResource B.Bad}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource B.Bad}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- Window caption buttons: square, no border, red on close hover. -->
  <Style x:Key="Btn.Caption" TargetType="Button">
    <Setter Property="Width" Value="42"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource B.TextDim}"/>
    <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.Hairline}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Btn.CaptionClose" TargetType="Button" BasedOn="{StaticResource Btn.Caption}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.CloseHover}"/>
              <Setter Property="Foreground" Value="White"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ inputs ============================= -->
  <Style x:Key="Input.Text" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource F.Sans}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource B.Text}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource B.Accent}"/>
    <Setter Property="Padding" Value="9,6"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Background" Value="{DynamicResource B.Surface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource B.Hairline}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border CornerRadius="8" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                          VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================== combo box (fully templated) ====================
       A setters-only style is not enough here. WPF's default ComboBox template
       renders its dropdown on the system popup background — which is light —
       while the items inherit the Foreground set on the ComboBox. In the dark
       theme that put light text on a light popup, and the list became
       unreadable. Owning the template is the only way to theme the popup.   -->

  <Style TargetType="ComboBoxItem">
    <Setter Property="FontFamily" Value="{StaticResource F.Sans}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                  CornerRadius="5" Margin="3,1">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.RowHover}"/>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.RowSelected}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.AccentTint}"/>
              <Setter Property="Foreground" Value="{DynamicResource B.Accent}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Input.Combo" TargetType="ComboBox">
    <Setter Property="FontFamily" Value="{StaticResource F.Sans}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
    <Setter Property="Background" Value="{DynamicResource B.Surface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource B.Hairline}"/>
    <Setter Property="Padding" Value="10,5"/>
    <Setter Property="Height" Value="30"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>

            <ToggleButton x:Name="toggle" Focusable="False" ClickMode="Press"
                          Background="Transparent" BorderThickness="0"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                      RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border Background="Transparent"/>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>

            <ContentPresenter x:Name="selection"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                              Margin="10,0,28,0" VerticalAlignment="Center"
                              IsHitTestVisible="False"/>

            <!-- Present only so IsEditable works; hidden otherwise. -->
            <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed"
                     Margin="10,0,28,0" VerticalAlignment="Center"
                     Background="Transparent" BorderThickness="0"
                     Foreground="{TemplateBinding Foreground}"
                     CaretBrush="{DynamicResource B.Text}"
                     SelectionBrush="{DynamicResource B.Accent}"
                     FontFamily="{StaticResource F.Sans}" FontSize="12.5"/>

            <Path x:Name="chevron" Data="M1,1 L5,5 L9,1" Stroke="{DynamicResource B.TextDim}"
                  StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0"
                  IsHitTestVisible="False"/>

            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                   Placement="Bottom" AllowsTransparency="True" Focusable="False"
                   PopupAnimation="Fade">
              <Border Background="{DynamicResource B.Surface}"
                      BorderBrush="{DynamicResource B.Hairline}" BorderThickness="1"
                      CornerRadius="8" Padding="2" Margin="0,3,0,0"
                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}"
                      Effect="{DynamicResource E.Card}">
                <ScrollViewer>
                  <ItemsPresenter/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>

          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource B.Accent2}"/>
            </Trigger>
            <Trigger Property="IsEditable" Value="True">
              <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
              <Setter TargetName="selection" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Input.Check" TargetType="CheckBox">
    <Setter Property="FontFamily" Value="{StaticResource F.Sans}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="box" Width="15" Height="15" CornerRadius="4" VerticalAlignment="Center"
                    Background="{DynamicResource B.Surface}" BorderThickness="1"
                    BorderBrush="{DynamicResource B.TextFaint}">
              <Path x:Name="tick" Data="M2,6 L5.5,9.5 L11,3" Stroke="{DynamicResource B.Surface}"
                    StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    StrokeLineJoin="Round" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="box" Property="Background" Value="{DynamicResource B.Accent}"/>
              <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
              <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource B.Accent2}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Default tooltips render dark text on a light system background, which is
       both unreadable beside a dark window and inconsistent beside a light one. -->
  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
    <Setter Property="FontFamily" Value="{StaticResource F.Sans}"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="MaxWidth" Value="320"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{DynamicResource B.Surface}" CornerRadius="7" Padding="10,7"
                  BorderThickness="1" BorderBrush="{DynamicResource B.Hairline}"
                  Effect="{DynamicResource E.Card}">
            <ContentPresenter>
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock">
                  <Setter Property="TextWrapping" Value="Wrap"/>
                </Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Scrollbars are the last piece of stock chrome that stays light. -->
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="9"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border CornerRadius="4" Margin="2,0"
                              Background="{DynamicResource B.TextFaint}" Opacity="0.5"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
              </Track.IncreaseRepeatButton>
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
              </Track.DecreaseRepeatButton>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
              <Setter Property="Height" Value="9"/>
              <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>


  <!-- ============================= icons =============================
       Drawn as geometry rather than shipped as an icon font or SVG set, so the
       binary stays self-contained and the strokes scale cleanly at any DPI.
       Thin-stroke shapes, matching the design's Phosphor-style set.          -->
  <Geometry x:Key="I.Wifi">M2.5,8.5 C6.5,5 17.5,5 21.5,8.5 M6,12 C9,9.6 15,9.6 18,12 M9.5,15.4 C11,14.2 13,14.2 14.5,15.4 M11,18.6 A1,1 0 1,1 13,18.6 A1,1 0 1,1 11,18.6 Z</Geometry>
  <Geometry x:Key="I.Cpu">M8.5,8.5 H15.5 V15.5 H8.5 Z M5.5,5.5 H18.5 V18.5 H5.5 Z M9.5,5.5 V3 M14.5,5.5 V3 M9.5,21 V18.5 M14.5,21 V18.5 M5.5,9.5 H3 M5.5,14.5 H3 M21,9.5 H18.5 M21,14.5 H18.5</Geometry>
  <Geometry x:Key="I.Sliders">M3,7 H21 M3,12 H21 M3,17 H21 M8,5.6 A1.4,1.4 0 1,1 7.99,5.6 Z M15,10.6 A1.4,1.4 0 1,1 14.99,10.6 Z M10,15.6 A1.4,1.4 0 1,1 9.99,15.6 Z</Geometry>
  <Geometry x:Key="I.Pulse">M2,12 H7 L10,5 L14,19 L17,12 H22</Geometry>
  <Geometry x:Key="I.Info">M12,3 A9,9 0 1,1 11.99,3 Z M12,11.2 V16.6 M12,7.4 V8.6</Geometry>
  <Geometry x:Key="I.Game">M7.5,10 V14 M5.5,12 H9.5 M15,11.2 A0.7,0.7 0 1,1 14.99,11.2 Z M17,13.4 A0.7,0.7 0 1,1 16.99,13.4 Z M7.6,6.5 H16.4 A4.6,4.6 0 0,1 21,11.1 V13.8 A3.7,3.7 0 0,1 17.3,17.5 A2.6,2.6 0 0,1 15,16.2 L14.3,15 H9.7 L9,16.2 A2.6,2.6 0 0,1 6.7,17.5 A3.7,3.7 0 0,1 3,13.8 V11.1 A4.6,4.6 0 0,1 7.6,6.5 Z</Geometry>
  <Geometry x:Key="I.Sun">M12,5.2 A6.8,6.8 0 1,1 11.99,5.2 Z M12,1.5 V3.2 M12,20.8 V22.5 M1.5,12 H3.2 M20.8,12 H22.5 M4.6,4.6 L5.8,5.8 M18.2,18.2 L19.4,19.4 M19.4,4.6 L18.2,5.8 M5.8,18.2 L4.6,19.4</Geometry>
  <Geometry x:Key="I.Moon">M20.5,14.6 A9,9 0 1,1 9.4,3.5 A7.2,7.2 0 0,0 20.5,14.6 Z</Geometry>
  <Geometry x:Key="I.WifiOff">M2.5,8.5 C4.6,6.7 7.4,5.6 10.3,5.2 M16.2,6.3 C18.2,6.9 20.1,7.6 21.5,8.5 M6,12 C7.2,11 8.7,10.3 10.3,10 M15.6,11 C16.5,11.3 17.3,11.6 18,12 M9.5,15.4 C10.3,14.7 11.4,14.3 12.5,14.3 M11,18.6 A1,1 0 1,1 13,18.6 A1,1 0 1,1 11,18.6 Z M3,3 L21,21</Geometry>

  <Style x:Key="Icon" TargetType="Path">
    <Setter Property="Stroke" Value="{DynamicResource B.TextDim}"/>
    <Setter Property="StrokeThickness" Value="1.4"/>
    <Setter Property="StrokeStartLineCap" Value="Round"/>
    <Setter Property="StrokeEndLineCap" Value="Round"/>
    <Setter Property="StrokeLineJoin" Value="Round"/>
    <Setter Property="Fill" Value="Transparent"/>
    <Setter Property="Width" Value="16"/>
    <Setter Property="Height" Value="16"/>
    <Setter Property="Stretch" Value="Uniform"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- ========================== navigation ===========================
       RadioButtons in one group so mutual exclusion is free.               -->
  <Style x:Key="NavItem" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Margin" Value="8,1"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="bd" CornerRadius="7" Background="Transparent" Height="34" Padding="10,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Path x:Name="ic" Style="{StaticResource Icon}"
                    Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
              <TextBlock x:Name="tx" Margin="10,0,0,0" VerticalAlignment="Center"
                         FontFamily="{StaticResource F.Sans}" FontSize="12.5"
                         Foreground="{DynamicResource B.TextSecondary}"
                         Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"/>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.RowHover}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.AccentTint}"/>
              <Setter TargetName="tx" Property="Foreground" Value="{DynamicResource B.Accent}"/>
              <Setter TargetName="tx" Property="FontWeight" Value="SemiBold"/>
              <Setter TargetName="ic" Property="Stroke" Value="{DynamicResource B.Accent}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
