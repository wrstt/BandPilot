<UserControl x:Class="BandPilot.Ui.MonitorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource F.Sans}">
  <Grid Margin="18,16,18,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <TextBlock Text="Live traffic" Style="{StaticResource T.PageTitle}"/>
      <StackPanel x:Name="Totals" Orientation="Horizontal" HorizontalAlignment="Right"
                  VerticalAlignment="Center" Visibility="Collapsed">
        <TextBlock Text="Down" Style="{StaticResource T.Dim}" FontSize="12"/>
        <TextBlock x:Name="TotalDown" Margin="6,0,0,0" FontSize="12.5" FontWeight="SemiBold"
                   Foreground="{StaticResource B.Accent}" VerticalAlignment="Center"/>
        <TextBlock Text="Up" Style="{StaticResource T.Dim}" FontSize="12" Margin="16,0,0,0"/>
        <TextBlock x:Name="TotalUp" Margin="6,0,0,0" FontSize="12.5" FontWeight="SemiBold"
                   Foreground="{StaticResource B.Good}" VerticalAlignment="Center"/>
        <TextBlock x:Name="ProcCount" Style="{StaticResource T.Dim}" FontSize="12" Margin="16,0,0,0"/>
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,13,0,0" ClipToBounds="True">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="TableHeader" Grid.Row="0" BorderBrush="{StaticResource B.Hairline}"
                BorderThickness="0,0,0,1" Padding="14,10" Visibility="Collapsed">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" MinWidth="150"/>
              <ColumnDefinition Width="66"/>
              <ColumnDefinition Width="106"/>
              <ColumnDefinition Width="106"/>
              <ColumnDefinition Width="106"/>
              <ColumnDefinition Width="106"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="PROCESS" Style="{StaticResource T.Kicker}"/>
            <TextBlock Grid.Column="1" Text="PID" Style="{StaticResource T.Kicker}" HorizontalAlignment="Right"/>
            <TextBlock Grid.Column="2" Text="DOWNLOAD" Style="{StaticResource T.Kicker}" HorizontalAlignment="Right"/>
            <TextBlock Grid.Column="3" Text="UPLOAD" Style="{StaticResource T.Kicker}" HorizontalAlignment="Right"/>
            <TextBlock Grid.Column="4" Text="TOTAL DOWN" Style="{StaticResource T.Kicker}" HorizontalAlignment="Right"/>
            <TextBlock Grid.Column="5" Text="TOTAL UP" Style="{StaticResource T.Kicker}" HorizontalAlignment="Right"/>
          </Grid>
        </Border>

        <ListBox x:Name="ProcList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0"/>
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bd" Background="Transparent">
                      <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="bd" Property="Background" Value="{StaticResource B.RowHover}"/>
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="bd" Property="Background" Value="{StaticResource B.RowSelected}"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Height="33" Margin="14,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" MinWidth="150"/>
                  <ColumnDefinition Width="66"/>
                  <ColumnDefinition Width="106"/>
                  <ColumnDefinition Width="106"/>
                  <ColumnDefinition Width="106"/>
                  <ColumnDefinition Width="106"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource T.Body}"
                           FontSize="12" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding Pid}" Style="{StaticResource T.Secondary}"
                           FontSize="12" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="2" Text="{Binding Down}" FontSize="12" VerticalAlignment="Center"
                           HorizontalAlignment="Right" Foreground="{StaticResource B.Accent}"/>
                <TextBlock Grid.Column="3" Text="{Binding Up}" FontSize="12" VerticalAlignment="Center"
                           HorizontalAlignment="Right" Foreground="{StaticResource B.Good}"/>
                <TextBlock Grid.Column="4" Text="{Binding TotalDown}" Style="{StaticResource T.Dim}"
                           FontSize="12" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="5" Text="{Binding TotalUp}" Style="{StaticResource T.Dim}"
                           FontSize="12" HorizontalAlignment="Right"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border x:Name="OffState" Grid.Row="1" Margin="16" CornerRadius="10"
                Background="{StaticResource B.Surface}"
                BorderThickness="1" BorderBrush="{StaticResource B.Hairline}">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Path Style="{StaticResource Icon}" Data="{StaticResource I.Pulse}" Width="26" Height="26"
                  Stroke="{StaticResource B.TextFaint}" HorizontalAlignment="Center"/>
            <TextBlock x:Name="OffTitle" Text="Monitoring is off" Margin="0,11,0,0" FontSize="13"
                       FontWeight="SemiBold" HorizontalAlignment="Center"
                       Foreground="{StaticResource B.TextSecondary}"/>
            <TextBlock x:Name="OffBody" Margin="0,5,0,0" FontSize="12" HorizontalAlignment="Center"
                       TextAlignment="Center" MaxWidth="420" TextWrapping="Wrap"
                       Foreground="{StaticResource B.TextFaint}"
                       Text="Start monitoring to see per-process bandwidth, updated every second."/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
      <Button x:Name="BtnStart" Style="{StaticResource Btn.Primary}" Content="Start monitoring"
              MinWidth="146" Click="OnToggle"/>
      <Button x:Name="BtnReset" Style="{StaticResource Btn.Secondary}" Content="Reset totals"
              Margin="9,0,0,0" Click="OnReset"/>
      <Button x:Name="BtnRule" Style="{StaticResource Btn.Ghost}" Content="Create a rule for this app"
              Margin="6,0,0,0" Click="OnCreateRule"/>
    </StackPanel>

    <TextBlock x:Name="StatusLine" Grid.Row="3" Style="{StaticResource T.Dim}" FontSize="12"
               Margin="0,10,0,0" TextWrapping="Wrap"/>
  </Grid>
</UserControl>
