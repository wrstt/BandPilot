<Window x:Class="BandPilot.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="BandPilot"
        Width="1100" Height="700" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource B.Background}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        FontFamily="{StaticResource F.Sans}">

  <!-- Custom caption, but via WindowChrome rather than WindowStyle=None, so
       Aero Snap, drag-to-maximise and the resize borders all keep working. -->
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                        CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Grid>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="36"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- ============================ title bar ============================ -->
      <Border Grid.Row="0" Background="{DynamicResource B.Surface}"
              BorderBrush="{DynamicResource B.Hairline}" BorderThickness="0,0,0,1">
        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
            <Ellipse Width="7" Height="7" Fill="{DynamicResource B.Accent2}" VerticalAlignment="Center"/>
            <TextBlock Text="BandPilot" Margin="9,0,0,0" FontSize="12"
                       Foreground="{DynamicResource B.TextSecondary}" VerticalAlignment="Center"/>
          </StackPanel>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                      shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button x:Name="BtnMin" Style="{StaticResource Btn.Caption}" Content="&#xE921;" Click="OnMinimise"/>
            <Button x:Name="BtnMax" Style="{StaticResource Btn.Caption}" Content="&#xE922;" Click="OnMaximise"/>
            <Button x:Name="BtnClose" Style="{StaticResource Btn.CaptionClose}" Content="&#xE8BB;" Click="OnClose"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ============================== body =============================== -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="168"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource B.Surface}"
                BorderBrush="{DynamicResource B.Hairline}" BorderThickness="0,0,1,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="18,18,14,0">
              <TextBlock FontSize="16" FontWeight="Bold" Foreground="{DynamicResource B.Heading}">
                <Run Text="Band"/><Run Text="Pilot" Foreground="{DynamicResource B.Accent}"/>
              </TextBlock>
              <TextBlock Text="Band control for any Wi-Fi card" FontSize="10"
                         Foreground="{DynamicResource B.TextFaint}" TextWrapping="Wrap"
                         Margin="0,4,0,0" LineHeight="14"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,16,0,0">
              <RadioButton x:Name="NavBands" Style="{StaticResource NavItem}" GroupName="nav"
                           Content="Bands &amp; APs" Tag="{StaticResource I.Wifi}"
                           IsChecked="True" Checked="OnNavChecked"/>
              <RadioButton x:Name="NavAdapter" Style="{StaticResource NavItem}" GroupName="nav"
                           Content="Adapter" Tag="{StaticResource I.Cpu}" Checked="OnNavChecked"/>
              <RadioButton x:Name="NavPriority" Style="{StaticResource NavItem}" GroupName="nav"
                           Content="Priority &amp; limits" Tag="{StaticResource I.Sliders}" Checked="OnNavChecked"/>
              <RadioButton x:Name="NavTraffic" Style="{StaticResource NavItem}" GroupName="nav"
                           Content="Live traffic" Tag="{StaticResource I.Pulse}" Checked="OnNavChecked"/>
              <RadioButton x:Name="NavGame" Style="{StaticResource NavItem}" GroupName="nav"
                           Content="Game mode" Tag="{StaticResource I.Game}" Checked="OnNavChecked"/>
              <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" GroupName="nav"
                           Content="About" Tag="{StaticResource I.Info}" Checked="OnNavChecked"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,0,0,12">
              <Border Height="1" Background="{DynamicResource B.Hairline}" Margin="18,0,18,10"/>
              <Button x:Name="BtnTheme" Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Left"
                      Margin="12,0,12,4" Padding="6,5" Click="OnThemeClick">
                <StackPanel Orientation="Horizontal">
                  <Path x:Name="ThemeIcon" Style="{StaticResource Icon}" Width="14" Height="14"
                        Data="{StaticResource I.Moon}"/>
                  <TextBlock x:Name="ThemeLabel" Margin="9,0,0,0" FontSize="11.5"
                             Foreground="{DynamicResource B.TextSecondary}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="BtnQos" Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Left"
                      Margin="12,0,12,0" Padding="6,5" Click="OnQosClick">
                <StackPanel Orientation="Horizontal">
                  <Ellipse x:Name="QosDot" Width="7" Height="7" Fill="{DynamicResource B.TextFaint}"
                           VerticalAlignment="Center"/>
                  <TextBlock x:Name="QosLabel" Text="Enable QoS marking" Margin="9,0,0,0" FontSize="11.5"
                             Foreground="{DynamicResource B.TextSecondary}" TextWrapping="Wrap"
                             MaxWidth="118" TextAlignment="Left"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <!-- page host -->
        <ContentControl x:Name="PageHost" Grid.Column="1"/>
      </Grid>
    </Grid>

    <!-- ============================== modal ============================== -->
    <!-- One overlay for the whole window; pages call ShowDialog on the shell
         rather than each owning its own popup plumbing. -->
    <Grid x:Name="ModalLayer" Visibility="Collapsed" Background="{DynamicResource B.Overlay}">
      <Border Style="{StaticResource Card}" CornerRadius="12" Width="440"
              HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
        <StackPanel>
          <TextBlock x:Name="ModalTitle" FontSize="14.5" FontWeight="SemiBold"
                     Foreground="{DynamicResource B.Heading}" TextWrapping="Wrap"/>
          <TextBlock x:Name="ModalBody" Margin="0,9,0,0" FontSize="12.5" LineHeight="18"
                     Foreground="{DynamicResource B.TextSecondary}" TextWrapping="Wrap"/>

          <Border x:Name="ModalCodeWrap" Visibility="Collapsed" Margin="0,12,0,0"
                  Background="{DynamicResource B.Background}" CornerRadius="8" Padding="11,9">
            <TextBox x:Name="ModalCode" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                     FontFamily="{StaticResource F.Mono}" FontSize="11"
                     Foreground="{DynamicResource B.TextSecondary}"
                     TextWrapping="Wrap" AcceptsReturn="True"/>
          </Border>

          <TextBlock x:Name="ModalNote" Visibility="Collapsed" Margin="0,11,0,0" FontSize="11.5"
                     Foreground="{DynamicResource B.WarnText}" TextWrapping="Wrap"/>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="ModalCancel" Style="{StaticResource Btn.Secondary}" Content="Cancel"
                    MinWidth="82" Click="OnModalCancel"/>
            <Button x:Name="ModalConfirm" Style="{StaticResource Btn.Primary}" Content="OK"
                    MinWidth="82" Margin="9,0,0,0" Click="OnModalConfirm"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
