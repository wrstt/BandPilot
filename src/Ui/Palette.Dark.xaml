<!--
    Dark "midnight" palette, taken from the design tool's own dark exploration
    rather than invented by dimming the light one — desaturating a light theme
    reliably produces mud.

    Same key set as Palette.Light.xaml, and the same rule holds: bands are
    purple / blue / slate while status is green / amber / red, so a band colour
    can never be mistaken for a health colour. Accent is cyan, deliberately
    distinct from the blue used for 5 GHz.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Color x:Key="C.Background">#16161F</Color>
  <Color x:Key="C.Surface">#1E1E30</Color>
  <Color x:Key="C.Text">#EEF1F8</Color>
  <Color x:Key="C.Heading">#F5F8FF</Color>
  <Color x:Key="C.TextSecondary">#C6CBD9</Color>
  <Color x:Key="C.TextDim">#8B93A7</Color>
  <Color x:Key="C.TextFaint">#6A7A99</Color>
  <Color x:Key="C.Accent">#22D3EE</Color>
  <Color x:Key="C.Accent2">#06B6D4</Color>
  <Color x:Key="C.Good">#34D399</Color>
  <Color x:Key="C.WarnText">#FBBF24</Color>
  <Color x:Key="C.WarnRail">#FCD34D</Color>
  <Color x:Key="C.Bad">#F26D6D</Color>
  <Color x:Key="C.Band6">#A78BFA</Color>
  <Color x:Key="C.Band5">#60A5FA</Color>
  <Color x:Key="C.Band24">#94A3B8</Color>
  <Color x:Key="C.CloseHover">#E5484D</Color>

  <!-- Hairlines and row washes key off a light colour here, because tinting
       with the dark text colour would be invisible against a dark surface. -->
  <Color x:Key="C.Line">#8FA3C8</Color>

  <SolidColorBrush x:Key="B.Background" Color="{StaticResource C.Background}"/>
  <SolidColorBrush x:Key="B.Surface" Color="{StaticResource C.Surface}"/>
  <SolidColorBrush x:Key="B.Text" Color="{StaticResource C.Text}"/>
  <SolidColorBrush x:Key="B.Heading" Color="{StaticResource C.Heading}"/>
  <SolidColorBrush x:Key="B.TextSecondary" Color="{StaticResource C.TextSecondary}"/>
  <SolidColorBrush x:Key="B.TextDim" Color="{StaticResource C.TextDim}"/>
  <SolidColorBrush x:Key="B.TextFaint" Color="{StaticResource C.TextFaint}"/>
  <SolidColorBrush x:Key="B.Accent" Color="{StaticResource C.Accent}"/>
  <SolidColorBrush x:Key="B.Accent2" Color="{StaticResource C.Accent2}"/>
  <SolidColorBrush x:Key="B.Good" Color="{StaticResource C.Good}"/>
  <SolidColorBrush x:Key="B.WarnText" Color="{StaticResource C.WarnText}"/>
  <SolidColorBrush x:Key="B.WarnRail" Color="{StaticResource C.WarnRail}"/>
  <SolidColorBrush x:Key="B.Bad" Color="{StaticResource C.Bad}"/>
  <SolidColorBrush x:Key="B.Band6" Color="{StaticResource C.Band6}"/>
  <SolidColorBrush x:Key="B.Band5" Color="{StaticResource C.Band5}"/>
  <SolidColorBrush x:Key="B.Band24" Color="{StaticResource C.Band24}"/>
  <SolidColorBrush x:Key="B.CloseHover" Color="{StaticResource C.CloseHover}"/>

  <SolidColorBrush x:Key="B.Band6Bg" Color="{StaticResource C.Band6}" Opacity="0.16"/>
  <SolidColorBrush x:Key="B.Band5Bg" Color="{StaticResource C.Band5}" Opacity="0.16"/>
  <SolidColorBrush x:Key="B.Band24Bg" Color="{StaticResource C.Band24}" Opacity="0.16"/>

  <SolidColorBrush x:Key="B.Hairline" Color="{StaticResource C.Line}" Opacity="0.18"/>
  <SolidColorBrush x:Key="B.RowRule" Color="{StaticResource C.Line}" Opacity="0.10"/>
  <SolidColorBrush x:Key="B.RowHover" Color="{StaticResource C.Accent}" Opacity="0.07"/>
  <SolidColorBrush x:Key="B.RowSelected" Color="{StaticResource C.Accent}" Opacity="0.12"/>
  <SolidColorBrush x:Key="B.RowConnected" Color="{StaticResource C.Accent2}" Opacity="0.12"/>
  <SolidColorBrush x:Key="B.AccentTint" Color="{StaticResource C.Accent}" Opacity="0.14"/>
  <SolidColorBrush x:Key="B.Accent2Tint" Color="{StaticResource C.Accent2}" Opacity="0.14"/>
  <SolidColorBrush x:Key="B.WarnTint" Color="{StaticResource C.WarnRail}" Opacity="0.14"/>
  <SolidColorBrush x:Key="B.Overlay" Color="#000000" Opacity="0.55"/>

  <!-- Near-black and tighter: a soft grey shadow on a dark ground reads as fog. -->
  <DropShadowEffect x:Key="E.Card" BlurRadius="8" ShadowDepth="1" Direction="270"
                    Color="#000000" Opacity="0.45"/>
</ResourceDictionary>
